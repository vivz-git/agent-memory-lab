# ==============================================================================
# Agent Memory Management Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=openai

# OpenAI Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq Provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Agent Backbone & Evaluator Configuration
MODEL_TEMPERATURE=0.0
EVALUATOR_MODEL=gpt-4o-mini

# Experiment Runtime & Logging
LOG_LEVEL=INFO
RESULTS_DIR=./results
RANDOM_SEED=42

# Environment Execution Defaults
BENCHMARK_ENV=reg_agent
NUM_STEPS=1000
INITIAL_MEMORY_SIZE=100
TOP_K=6
MEMORY_CAPACITY=100
